<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".PaymentSuccessActivity">

    <!-- Scrollable content area (no toolbar — this is a full success page) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="32dp">

            <!-- Spacer to push content toward center -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Success checkmark circle -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="24dp">

                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_success_circle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✓"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

            </FrameLayout>

            <!-- Success title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_success_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/payment_success_green"
                android:layout_marginBottom="8dp" />

            <!-- Success subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_success_subtitle"
                android:textSize="16sp"
                android:textColor="@color/category_text"
                android:layout_marginBottom="32dp" />

            <!-- Order details card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/payment_success_bg"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Order Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_success_order_label"
                        android:textSize="12sp"
                        android:textColor="@color/category_text"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/textSuccessOrderNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_700"
                        android:layout_marginBottom="16dp"
                        tools:text="Order #5" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/quantity_btn_bg"
                        android:layout_marginBottom="16dp" />

                    <!-- Transaction Reference -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_success_txn_label"
                        android:textSize="12sp"
                        android:textColor="@color/category_text"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/textSuccessTransactionRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="16dp"
                        tools:text="TXN-1722610234567" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/quantity_btn_bg"
                        android:layout_marginBottom="16dp" />

                    <!-- Amount Paid -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_success_amount_label"
                        android:textSize="12sp"
                        android:textColor="@color/category_text"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/textSuccessAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/price_green"
                        tools:text="$12.50" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Spacer to push content toward center -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom section: action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/checkout_bg"
        android:elevation="8dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewOrderStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_view_order_status"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToMenuFromSuccess"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_back_to_menu"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/purple_500" />

    </LinearLayout>

</LinearLayout>
