<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".OrderStatusActivity">

    <!-- Toolbar with back navigation -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarOrderStatus"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/purple_500"
        app:title="@string/order_status_title"
        app:titleTextColor="@color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white" />

    <!-- Scrollable content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Order header card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textOrderId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_700"
                        tools:text="Order #1" />

                    <TextView
                        android:id="@+id/textOrderDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/category_text"
                        android:layout_marginTop="4dp"
                        tools:text="Placed: 2026-08-01 10:30" />

                    <TextView
                        android:id="@+id/textOrderTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/price_green"
                        android:layout_marginTop="4dp"
                        tools:text="Total: $12.50" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Status message banner -->
            <LinearLayout
                android:id="@+id/layoutStatusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/status_message_bg"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textStatusMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:textColor="@color/purple_700"
                    android:lineSpacingExtra="2dp"
                    tools:text="Sit tight! Your order has been placed." />

            </LinearLayout>

            <!-- Status stepper container -->
            <LinearLayout
                android:id="@+id/layoutStatusStepper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- Auto-refresh indicator -->
            <TextView
                android:id="@+id/textAutoRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_auto_refresh"
                android:textSize="12sp"
                android:textColor="@color/category_text"
                android:layout_gravity="center"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom section: action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/checkout_bg"
        android:elevation="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshStatus"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_refresh_status"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/purple_500" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_back_to_menu"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:layout_marginStart="8dp"
            app:cornerRadius="8dp" />

    </LinearLayout>

</LinearLayout>
