<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/status_current_ring" />
            <size
                android:width="28dp"
                android:height="28dp" />
        </shape>
    </item>
    <!-- Inner filled circle -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/status_current" />
        </shape>
    </item>
</layer-list>
