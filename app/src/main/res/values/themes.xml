<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================================================================== -->
    <!-- Base application theme — warm, modern food ordering brand          -->
    <!-- ================================================================== -->
    <style name="Theme.FoodPickupApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color — warm amber -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <!-- Secondary brand color — warm brown -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_secondary_light</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <!-- Background & surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- Error -->
        <item name="colorError">@color/error</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <!-- Default button style -->
        <item name="materialButtonStyle">@style/Widget.FoodPickup.Button</item>
    </style>

    <!-- ================================================================== -->
    <!-- Custom Material Button — rounded, branded                         -->
    <!-- ================================================================== -->
    <style name="Widget.FoodPickup.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/brand_primary</item>
    </style>

    <!-- Outlined variant -->
    <style name="Widget.FoodPickup.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <!-- Text variant -->
    <style name="Widget.FoodPickup.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <!-- ================================================================== -->
    <!-- Card styles                                                        -->
    <!-- ================================================================== -->
    <style name="Widget.FoodPickup.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.FoodPickup.Card.Elevated" parent="Widget.FoodPickup.Card">
        <item name="cardElevation">6dp</item>
    </style>

    <!-- ================================================================== -->
    <!-- Text Input Layout — branded                                       -->
    <!-- ================================================================== -->
    <style name="Widget.FoodPickup.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="hintTextColor">@color/brand_primary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- ================================================================== -->
    <!-- Text Appearances                                                   -->
    <!-- ================================================================== -->
    <style name="TextAppearance.FoodPickup.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.FoodPickup.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.FoodPickup.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.FoodPickup.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.FoodPickup.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_hint</item>
    </style>

</resources>