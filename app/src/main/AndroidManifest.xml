<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodPickupApp">

        <!-- Login is now the launcher activity (FOOD-6) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FoodPickupApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registration screen (FOOD-5) -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="@string/register_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Menu screen (FOOD-11) -->
        <activity
            android:name=".MenuActivity"
            android:exported="false"
            android:label="@string/menu_title"
            android:parentActivityName=".MainActivity" />

        <!-- Cart screen (FOOD-12, FOOD-13) -->
        <activity
            android:name=".CartActivity"
            android:exported="false"
            android:label="@string/cart_title"
            android:parentActivityName=".MenuActivity" />

        <!-- Checkout screen (FOOD-14) -->
        <activity
            android:name=".CheckoutActivity"
            android:exported="false"
            android:label="@string/checkout_title"
            android:parentActivityName=".CartActivity" />

        <!-- Payment screen (FOOD-15) -->
        <activity
            android:name=".PaymentActivity"
            android:exported="false"
            android:label="@string/payment_title"
            android:parentActivityName=".CheckoutActivity" />

        <!-- Payment success screen (FOOD-16) -->
        <activity
            android:name=".PaymentSuccessActivity"
            android:exported="false"
            android:parentActivityName=".MenuActivity" />

        <!-- Order status screen (FOOD-21) -->
        <activity
            android:name=".OrderStatusActivity"
            android:exported="false"
            android:label="@string/order_status_title"
            android:parentActivityName=".MainActivity" />

        <!-- Password reset screen (FOOD-7) -->
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:label="@string/forgot_password_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Admin staff creation screen (FOOD-8) -->
        <activity
            android:name=".AdminCreateStaffActivity"
            android:exported="false"
            android:label="@string/admin_create_staff_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main screen — no longer the launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.FoodPickupApp"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>